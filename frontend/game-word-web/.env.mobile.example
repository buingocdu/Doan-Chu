# Copy thành .env.mobile rồi sửa IP. Dùng khi build app mobile: npm run build:mobile
# App trên điện thoại không gọi được "localhost" của máy tính, phải dùng IP LAN (hoặc domain production).
#   Điện thoại thật cùng Wi-Fi: http://<IP-máy-chạy-backend>:8080/api
#   Android emulator:           http://10.0.2.2:8080/api
VITE_API_BASE_URL=http://192.168.1.45:8080/api
