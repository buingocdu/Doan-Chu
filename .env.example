# Copy to .env and adjust before deploying to production
POSTGRES_DB=game_word_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_PORT=5432
BACKEND_PORT=8080
# Bat buoc, it nhat 32 ky tu ngau nhien (backend tu choi khoi dong neu ngan hon): openssl rand -hex 32
JWT_SECRET=
CORS_ALLOWED_ORIGINS=https://your-domain.com
# SMTP cho chuc nang quen mat khau (vd Gmail: smtp.gmail.com / 587 / App Password)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-account@gmail.com
SPRING_MAIL_PASSWORD=your-app-password
MAIL_FROM=your-account@gmail.com
# Dia chi web frontend, dung tao link dat lai mat khau trong email
FRONTEND_URL=https://your-domain.com
