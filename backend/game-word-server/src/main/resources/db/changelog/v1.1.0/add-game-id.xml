<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

    <!-- game_id: id cua ban ghi bat dau van (attempt = 0), dung de dem luot theo tung van -->
    <changeSet id="5" author="claude">
        <addColumn tableName="game_histories">
            <column name="game_id" type="BIGINT">
                <constraints nullable="true"/>
            </column>
        </addColumn>
        <createIndex tableName="game_histories" indexName="idx_histories_game">
            <column name="game_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
