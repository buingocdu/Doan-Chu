<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

    <!-- Table: users (code-first from com.gameword.model.User) -->
    <changeSet id="1" author="kilo">
        <createTable tableName="users">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="username" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_users_username"/>
            </column>
            <column name="password" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_users_email"/>
            </column>
            <column name="total_score" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="true"/>
            </column>
            <column name="games_played" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="true"/>
            </column>
            <column name="games_won" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="true"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="true"/>
            </column>
        </createTable>
    </changeSet>

    <!-- Table: words (code-first from com.gameword.model.Word) -->
    <changeSet id="2" author="kilo">
        <createTable tableName="words">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="value" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_words_value"/>
            </column>
            <column name="part1" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="part2" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="level" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="true"/>
            </column>
        </createTable>
    </changeSet>

    <!-- Table: game_histories (code-first from com.gameword.model.GameHistory) -->
    <changeSet id="3" author="kilo">
        <createTable tableName="game_histories">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="true"/>
            </column>
            <column name="word_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="guess" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="result" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="attempt" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="correct" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="played_at" type="TIMESTAMP">
                <constraints nullable="true"/>
            </column>
        </createTable>
    </changeSet>

    <!-- Indexes -->
    <changeSet id="4" author="kilo">
        <createIndex tableName="game_histories" indexName="idx_histories_user">
            <column name="user_id"/>
        </createIndex>
        <createIndex tableName="game_histories" indexName="idx_histories_word">
            <column name="word_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
