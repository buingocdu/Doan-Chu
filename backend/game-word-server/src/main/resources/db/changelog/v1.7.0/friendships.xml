<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

    <!-- Ket ban: PENDING (cho chap nhan) / ACCEPTED. FriendService dam bao khong co cap nguoc chieu;
         tu choi / huy = xoa dong -->
    <changeSet id="21" author="claude">
        <createTable tableName="friendships">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="requester_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_friendships_requester" referencedTableName="users"
                             referencedColumnNames="id" deleteCascade="true"/>
            </column>
            <column name="addressee_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_friendships_addressee" referencedTableName="users"
                             referencedColumnNames="id" deleteCascade="true"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="responded_at" type="TIMESTAMP"/>
        </createTable>
        <addUniqueConstraint tableName="friendships" columnNames="requester_id, addressee_id"
                             constraintName="uk_friendships_pair"/>
        <createIndex tableName="friendships" indexName="idx_friendships_addressee">
            <column name="addressee_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
